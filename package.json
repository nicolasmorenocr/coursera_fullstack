{
  "name": "coursera_fullstack",
  "version": "1.0.0",
  "description": "primer proyecto full stack node js",
  "homepage": "https://github.com/nicolasmorenocr/coursera_fullstack#readme",
  "bugs": {
    "url": "https://github.com/nicolasmorenocr/coursera_fullstack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasmorenocr/coursera_fullstack.git"
  },
  "license": "ISC",
  "author": "Nicolas Moreno",
  "type": "commonjs",
  "main": "index.html",
  "scripts": {
    "dev": "lite-server",
    "test": "echo \"Error: no test specified\" && exit 1",
    "scss": "sass css/styles.scss css/main.css",
    "watch:scss": "onchange \"css/*.scss\" -- npm run scss",
    "start": "concurrently \"npm run dev\" \"npm run watch:scss\"",
    "clean": "rimraf dist",
    "imagemin": "node utils/compress.js",
    "usemin": "usemin index.html -d dist --htmlmin -o dist/index.html && usemin about.html -d dist --htmlmin -o dist/about.html && usemin precios.html -d dist --htmlmin -o dist/precios.html && usemin contacto.html -d dist --htmlmin -o dist/contacto.html",
    "build": "npm run clean && npm run scss && npm run imagemin && npm run usemin"
  },
  "devDependencies": {
    "cssmin": "^0.4.3",
    "htmlmin": "^0.0.7",
    "imagemin-optipng": "^8.0.0",
    "lite-server": "^2.6.1",
    "onchange": "^7.1.0",
    "rimraf": "^6.1.3",
    "sass": "^1.103.1",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "concurrently": "^10.0.5",
    "jquery": "^4.0.0",
    "open-iconic": "^1.1.1",
    "popper.js": "^1.16.1",
    "uglifyjs": "^2.4.11",
    "usemin-cli": "^0.6.0"
  }
}